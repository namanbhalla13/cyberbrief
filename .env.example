# Copy this file to .env before running CyberBrief.
# The defaults below run in fixture/demo mode and need no API key.

# AI_MODE=fixture replays labelled sample responses. Use AI_MODE=live only when you have a Meta API key.
AI_MODE=fixture
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_SPEECH_MODEL=muse-voice-transcribe-1.0

# Keep demo mode enabled for local use. Set PUBLIC_FIXTURES_ONLY=true to serve curated demo cases only.
APP_ENV=development
DEMO_MODE=true
PUBLIC_FIXTURES_ONLY=false
# Keep false for local HTTP. Set true only when the app is served over HTTPS.
COOKIE_SECURE=false
DEMO_RETENTION_HOURS=24

# Docker Compose publishes this host port. Change to 8080 if port 8000 is already in use.
HOST_PORT=8000

# The labelled bank sandbox uses fictional data. Email is off unless you configure SMTP below.
BANK_SANDBOX_ENABLED=true
BANK_PROVIDER_TIMEOUT_SECONDS=10
BANK_PROVIDER_RETRIES=1
BANK_CHECK_LEASE_SECONDS=120
EMAIL_MODE=off

# Optional: set EMAIL_MODE=smtp and fill these values to send bank requests by email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# EMAIL_FROM_ADDRESS=
# OFFICIAL_DEPARTMENT=
# OFFICIAL_CONTACT_EMAIL=
# OFFICIAL_CONTACT_PHONE=

# Optional: choose a password when seeding a demo officer. Otherwise a password is generated once.
# CB_OFFICER_PASSWORD=

# Optional tracing; leave disabled unless you have a LangSmith account and API key.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=

# Leave DATABASE_URL, STORAGE_ROOT and CHECKPOINT_DB unset for the defaults.
# Do not put real credentials in this example file. Put them only in your local .env.
