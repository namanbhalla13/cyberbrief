data/
*.db
*.db-wal
*.db-shm

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.deepeval/

# node
node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/

