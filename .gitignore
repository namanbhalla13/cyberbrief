evals/reports/*
!evals/reports/.gitkeep

# editors / os
.vscode/
.idea/
*.log
Thumbs.db
.DS_Store
frontend/screens/

# owner working notes kept locally; not part of the published repository
Main_md_file/

# local proxy trust for live mode in Docker (machine-specific)
certs/
compose.override.yaml

# submission media stays local
docs/
